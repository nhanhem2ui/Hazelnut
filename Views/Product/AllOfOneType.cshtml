						<div class="products row row-small large-columns-3 medium-columns-2 small-columns-2 has-shadow row-box-shadow-1 row-box-shadow-2-hover has-equal-box-heights equalize-box">
							@foreach (var item in Model.Products)
							{
								<div class="product-small col has-hover product type-product post-1075 status-publish instock shipping-taxable product-type-simple">
									<div class="col-inner">
										<div class="product-small box position-relative">

											<!-- Edit & Delete Icons -->
											<div class="product-icon-actions position-absolute top-0 end-0 m-2 z-3">
												<a href="@Url.Action("Edit", "Product", new { productId = item.ProductId, productType = Model.ProductType })"
												   class="text-primary me-2" title="Edit">
													<i class="fas fa-edit"></i>
												</a>
												<form asp-action="Delete" asp-controller="Product" method="post" class="d-inline">
													<input type="hidden" name="productId" value="@item.ProductId" />
													<input type="hidden" name="productType" value="@Model.ProductType" />
													<button type="submit" class="btn btn-link text-danger p-0" title="Delete"
															onclick="return confirm('Xóa sản phẩm này?');">
														<i class="fas fa-trash-alt"></i>
													</button>
												</form>
											</div>

											<!-- Product Image -->
											<div class="box-image">
												<div class="image-zoom">
													<a href="@Url.Action("Index", "Product", new { productId = item.ProductId, productType = Model.ProductType })"
													   aria-label="@item.Name">
														<img width="394" height="313" src="~/@item.ImagePath"
															 class="attachment-woocommerce_thumbnail size-woocommerce_thumbnail" alt="" decoding="async" fetchpriority="high">
													</a>
												</div>
											</div>

											<!-- Product Name -->
											<div class="box-text box-text-products text-center grid-style-2">
												<div class="title-wrapper">
													<p class="name product-title woocommerce-loop-product__title">
														<a href="@Url.Action("Index", "Product", new { productId = item.ProductId, productType = Model.ProductType })"
														   class="woocommerce-LoopProduct-link woocommerce-loop-product__link">@item.Name</a>
													</p>
												</div>
											</div>

											<!-- Order Now -->
											<div class="nut-mua-ngay">
												<a href="@Url.Action("Index", "Product", new { model = Model })">
													Đặt hàng ngay
												</a>
											</div>

										</div>
									</div>
								</div>
							}

							<style>
								.product-icon-actions {
									position: absolute;
									top: 8px;
									right: 8px;
									z-index: 10;
								}

									.product-icon-actions a,
									.product-icon-actions button {
										color: #333;
										font-size: 16px;
										background: white;
										border-radius: 50%;
										padding: 5px;
										margin: 2px;
										border: none;
										box-shadow: 0 0 3px rgba(0,0,0,0.1);
										transition: background 0.3s;
									}

										.product-icon-actions a:hover,
										.product-icon-actions button:hover {
											background: #f0f0f0;
											color: #007bff;
										}
							</style>
						</div><!-- row -->
						<!-- Pagination -->@* 
						<div class="pagination text-center" style="margin-top: 30px;">
							<ul class="page-numbers nav-pagination links text-center">
								@if (Model.TotalPages > 1)
								{
									if (Model.CurrentPage > 1)
									{
										<li>
											<span aria-current="page" class="page-number current">
												<a href="@Url.Action("AllOfOneType", new { productType = Model.ProductType, page = Model.CurrentPage - 1 })">«</a>
											</span>
										</li>
									}

									for (int i = 1; i <= Model.TotalPages; i++)
									{
										if (i == Model.CurrentPage)
										{
											<li class="active"><span>@i</span></li>
										}
										else
										{
											<li><a href="@Url.Action("AllOfOneType", new { productType = Model.ProductType, page = i })">@i</a></li>
										}
									}

									if (Model.CurrentPage < Model.TotalPages)
									{
										<li><a href="@Url.Action("AllOfOneType", new { productType = Model.ProductType, page = Model.CurrentPage + 1 })">»</a></li>
									}
								}
							</ul>
						</div>
						<!-- End Pagination --> *@
					</div><!-- shop container -->
				</div>
</div>
