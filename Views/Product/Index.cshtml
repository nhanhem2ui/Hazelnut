@model Hazelnut.Models.ViewModels.ProductDetailsViewModel
<body class="product-template-default single single-product postid-1065 theme-flatsome woocommerce woocommerce-page woocommerce-js header-shadow lightbox nav-dropdown-has-arrow nav-dropdown-has-shadow nav-dropdown-has-border catalog-mode">
	@{
		string? size = null;
		string? price = null;
		string? weight = null;
		string? origin = null;
		string? producer = null;
		string? description = null;

		if (Model.Product is ToiletPaper tp)
		{
			size = tp.Size;
			price = tp.Price;
			weight = tp.Weight;
			origin = tp.Origin;
			producer = tp.Producer;
			description = tp.Description;
		}
		else if (Model.Product is SmallToiletPaper stp)
		{
		    size = stp.Size;
		    price = stp.Price;
		    weight = stp.Weight;
		    origin = stp.Origin;
		    producer = stp.Producer;
		    description = stp.Description;
		}
		else if (Model.Product is Napkin napkin)
		{
		    size = napkin.Size;
		    price = napkin.Price;
		    weight = napkin.Weight;
		    origin = napkin.Origin;
		    producer = napkin.Producer;
		    description = napkin.Description;
		}
		else if (Model.Product is PaperHandkerchiefs hanky)
		{
		    size = hanky.Size;
		    price = hanky.Price;
		    weight = hanky.Weight;
		    origin = hanky.Origin;
		    producer = hanky.Producer;
		    description = hanky.Description;
		}
		else if (Model.Product is PaperContainer pc)
		{
		    size = pc.Size;
		    price = pc.Price;
		    weight = pc.Weight;
		    origin = pc.Origin;
		    producer = pc.Producer;
		    description = pc.Description;
		}
	}
